#!/usr/bin/env bash
# shellcheck shell=bash

# Locate ourselves for easy reference.
declare GAUDI_TEST_DIRECTORY

GAUDI_TEST_DIRECTORY="$(cd "$(dirname "$0")" && pwd)"

export GAUDI_BASH_DIR="${GAUDI_TEST_DIRECTORY%/*}"
export GAUDI_BATS="${GAUDI_TEST_DIRECTORY}/../bin/bats-core/bin/bats"
export GAUDI_TEST_DEPS_DIR="${GAUDI_BASH_DIR}/bin"

# The tests only check that the git submodules they need are there: they never fetch or move them, so a
# submodule that is being worked on is left as it is and a test run needs no network
missing_submodules=()
for submodule_file in \
	bin/bats-core/bin/bats \
	bin/bats-support/load.bash \
	bin/bats-assert/load.bash \
	bin/bats-file/load.bash \
	bin/composure/composure.sh \
	bin/preexec/bash-preexec.sh \
	components/aliases/lib \
	components/completions/lib \
	components/plugins/lib \
	components/themes/gaudi; do
	[[ -e "${GAUDI_BASH_DIR}/${submodule_file}" ]] || missing_submodules+=("$submodule_file")
done

if [[ ${#missing_submodules[@]} -gt 0 ]]; then
	printf "%s\n" "The tests need the git submodules of gaudi-bash, these are missing:" >&2
	printf "  %s\n" "${missing_submodules[@]}" >&2
	printf "%s\n" "Fetch them with: git -C '${GAUDI_BASH_DIR}' submodule update --init --recursive" >&2
	exit 1
fi

if [[ -z "${GAUDI_BASH_ORIGIN}" ]]; then
	declare GAUDI_BASH_ORIGIN
	GAUDI_BASH_ORIGIN=$(cd "${GAUDI_TEST_DIRECTORY%/*}" && pwd)
	export GAUDI_BASH_ORIGIN
fi

case $OSTYPE in
	darwin*)
		export GAUDI_BASH_PROFILE=".bash_profile"
		;;
	*)
		export GAUDI_BASH_PROFILE=".bashrc"
		;;
esac

export GAUDI_TEST_DIRECTORY

echo -e "
\033c
 ██████╗  █████╗ ██╗   ██╗██████╗ ██╗      ██████╗  █████╗ ███████╗██╗  ██╗
██╔════╝ ██╔══██╗██║   ██║██╔══██╗██║      ██╔══██╗██╔══██╗██╔════╝██║  ██║
██║  ███╗███████║██║   ██║██║  ██║██║█████╗██████╔╝███████║███████╗███████║
██║   ██║██╔══██║██║   ██║██║  ██║██║╚════╝██╔══██╗██╔══██║╚════██║██╔══██║
╚██████╔╝██║  ██║╚██████╔╝██████╔╝██║      ██████╔╝██║  ██║███████║██║  ██║
 ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚═╝      ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝


Running gaudi-bash unit tests.. \n\n"

status=0

if [[ $# -gt 0 ]]; then
	# Run only the test files or directories passed as arguments
	bash "$GAUDI_TEST_DIRECTORY"/runners/run-bats.bash "$@" || status=$?
else
	bash "$GAUDI_TEST_DIRECTORY"/runners/run-bats.bash || status=$?
	bash "$GAUDI_TEST_DIRECTORY"/runners/run-search.bash || status=$?
fi

exit "$status"
