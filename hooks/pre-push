#!/usr/bin/env bash
# Pre-push hook: runs lint and tests before allowing a push.
# Install: ln -sf ../../hooks/pre-push .git/hooks/pre-push

set -e

# The repository being pushed, wherever this hook is started from (the link in .git/hooks or this file)
GAUDI_BASH_DIR="$(git rev-parse --show-toplevel)"
cd "$GAUDI_BASH_DIR"

echo "Running pre-push checks..."

# Run pre-commit linting if available
if command -v pre-commit &>/dev/null; then
  echo "[pre-push] Running pre-commit lint..."
  pre-commit run --all-files || {
    echo "[pre-push] Lint failed. Fix issues before pushing."
    exit 1
  }
else
  # Fallback: run shellcheck and shfmt directly, on the shell files git tracks (the same set pre-commit lints)
  shell_files=()
  while IFS= read -r file; do
    case "$file" in
    test/fixtures/* | template/*) ;;
    *.bats) ;;
    *.sh | *.bash | test/run | hooks/*) shell_files+=("$file") ;;
    esac
  done < <(git ls-files)

  if command -v shellcheck &>/dev/null; then
    echo "[pre-push] Running shellcheck..."
    shellcheck --shell=bash "${shell_files[@]}" || {
      echo "[pre-push] shellcheck failed."
      exit 1
    }
  fi

  if command -v shfmt &>/dev/null; then
    echo "[pre-push] Running shfmt..."
    shfmt -d "${shell_files[@]}" || {
      echo "[pre-push] shfmt found formatting issues."
      exit 1
    }
  fi
fi

# Run tests
echo "[pre-push] Running tests..."
bash "$GAUDI_BASH_DIR/test/run" || {
  echo "[pre-push] Tests failed. Fix issues before pushing."
  exit 1
}

echo "[pre-push] All checks passed."
